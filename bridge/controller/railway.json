{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd bridge/controller && npm ci --ignore-scripts --no-audit --no-fund && npm run typecheck"
  },
  "deploy": {
    "startCommand": "cd bridge/controller && npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
